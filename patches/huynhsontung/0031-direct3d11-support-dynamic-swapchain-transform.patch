 }
 
+static void OrientationGetOps(video_orientation_t orient,
+                              unsigned *angle, bool *hflip)
+{
+    *hflip = ORIENT_IS_MIRROR(orient);
+    switch (orient)
+    {
+        case ORIENT_ROTATED_90:
+        case ORIENT_TRANSPOSED:
+            *angle = 90;
+            break;
+        case ORIENT_ROTATED_180:
+        case ORIENT_VFLIPPED:
+            *angle = 180;
+            break;
+        case ORIENT_ROTATED_270:
+        case ORIENT_ANTI_TRANSPOSED:
+            *angle = 270;
+            break;
+        case ORIENT_HFLIPPED:
+        case ORIENT_NORMAL:
+        default:
+            *angle = 0;
+            break;
+    }
+}
+
+static video_orientation_t ComposeOrientation(video_orientation_t base,
+                                              video_orientation_t user)
+{
+    unsigned angle1, angle2;
+    bool hflip1, hflip2;
+
+    OrientationGetOps(base, &angle1, &hflip1);
+    OrientationGetOps(user, &angle2, &hflip2);
+
+    unsigned angle = hflip1 ? (angle1 - angle2 + 360) % 360
+                            : (angle1 + angle2) % 360;
+    bool hflip = hflip1 ^ hflip2;
+
+    switch (angle)
+    {
+        case 90:
+            return hflip ? ORIENT_TRANSPOSED : ORIENT_ROTATED_90;
+        case 180:
+            return hflip ? ORIENT_VFLIPPED : ORIENT_ROTATED_180;
+        case 270:
+            return hflip ? ORIENT_ANTI_TRANSPOSED : ORIENT_ROTATED_270;
+        default:
+            return hflip ? ORIENT_HFLIPPED : ORIENT_NORMAL;
+    }
+}
+
+static bool UpdateWinRTTransform(vout_display_t *vd)
+{
+    vout_display_sys_t *sys = vd->sys;
+    if (sys->sys.pf_GetWindowSize != GetWinRTSize || !sys->dxgiswapChain)
+        return false;
+
+    uint32_t raw_transform = ORIENT_NORMAL;
+    UINT dataSize = sizeof(raw_transform);
+    HRESULT hr = IDXGISwapChain_GetPrivateData(sys->dxgiswapChain,
+                                               &GUID_SWAPCHAIN_TRANSFORM,
+                                               &dataSize, &raw_transform);
+    if (FAILED(hr) || dataSize != sizeof(raw_transform) ||
+        raw_transform > ORIENT_RIGHT_BOTTOM)
+        raw_transform = ORIENT_NORMAL;
+
+    video_orientation_t transform = (video_orientation_t)raw_transform;
+    if (transform == sys->user_transform)
+        return false;
+
+    sys->user_transform = transform;
+    video_orientation_t composed = ComposeOrientation(sys->base_orientation, transform);
+    vd->source.orientation = composed;
+    vd->fmt.orientation    = composed;
+    return true;
+}
+
 static int OpenCoreW(vout_display_t *vd)
 {
     IDXGISwapChain1* dxgiswapChain  = (void*)var_InheritInteger(vd, "winrt-swapchain");
@@ -335,6 +416,10 @@ static int Open(vlc_object_t *object)
     else if (CommonInit(vd) != VLC_SUCCESS)
         goto error;
 
+    sys->base_orientation = vd->source.orientation;
+    sys->user_transform   = ORIENT_NORMAL;
+    UpdateWinRTTransform(vd);
+
     vd->sys->sys.pf_GetPictureWidth  = GetPictureWidth;
     vd->sys->sys.pf_GetPictureHeight = GetPictureHeight;
 
@@ -976,10 +1061,15 @@ static void Manage(vout_display_t *vd)
     RECT before_src_clipped  = sys->sys.rect_src_clipped;
     RECT before_dest_clipped = sys->sys.rect_dest_clipped;
     RECT before_dest         = sys->sys.rect_dest;
+    bool orientation_changed = UpdateWinRTTransform(vd);
 
-    CommonManage(vd);
+    if (orientation_changed)
+        UpdateRects(vd, NULL, true);
+    else
+        CommonManage(vd);
 
-    if (!RectEquals(&before_src_clipped, &sys->sys.rect_src_clipped) ||
+    if (orientation_changed ||
+        !RectEquals(&before_src_clipped, &sys->sys.rect_src_clipped) ||
         !RectEquals(&before_dest_clipped, &sys->sys.rect_dest_clipped) ||
         !RectEquals(&before_dest, &sys->sys.rect_dest))
     {
